# CertMate Docker 配置模板
#
# Compose 部署：复制为 .env，填写后执行 docker compose up -d。
# 裸 docker run：复制为 production.env，使用 docker run --env-file production.env。
# 不要提交填写了真实 Secret 的配置文件。

# ---------- 应用基本信息 ----------
APP_NAME=CertMate
APP_ENV=production
LISTEN_ADDR=:8080
TZ=Asia/Shanghai

# ---------- 管理员账户（必须配置一种密码方式） ----------
ADMIN_USERNAME=admin
# 推荐填写 bcrypt 哈希；可用 htpasswd -nBC 12 admin 交互生成。
ADMIN_PASSWORD_HASH=
# 不推荐明文密码；只有未配置哈希/文件时才使用。
ADMIN_PASSWORD=
# 也可以将密码或哈希放在容器内只读文件中。
ADMIN_PASSWORD_FILE=
ADMIN_PASSWORD_HASH_FILE=

# ---------- 会话与 DNS 凭据加密（生产环境必须配置） ----------
# 生成命令：openssl rand -hex 32
# SESSION_SECRET 和 APP_ENCRYPTION_KEY 必须使用两个不同的值。
# 首次生成后必须持久化复用，不能每次重部署重新生成。
SESSION_SECRET=
SESSION_SECRET_FILE=
APP_ENCRYPTION_KEY=
APP_ENCRYPTION_KEY_FILE=
# 本地 HTTP 开发可设 false；HTTPS 生产环境保持 true。
SESSION_COOKIE_SECURE=true

# ---------- 容器内固定路径 ----------
# 这些是容器内路径，不要改成宿主机路径。
DATA_DIR=/data
CERT_OUTPUT_DIR=/certs
ACME_HOME=/data/acme
ACME_CHALLENGE_DIR=/data/challenges

# ---------- 证书默认值 ----------
# 可填 letsencrypt、letsencrypt_test、zerossl，或不含凭据/片段的 HTTPS Directory URL。
DEFAULT_CA=letsencrypt
DEFAULT_ACME_EMAIL=
DEFAULT_KEY_TYPE=ec-256
ENABLE_ACME=true
ENABLE_SELF_SIGNED=true

# ---------- 日志、反向代理和外部工具 ----------
LOG_LEVEL=info
# 只有 CertMate 位于可信反向代理后才设 true。
TRUST_PROXY=false
# TRUST_PROXY=true 时填写代理网段，例如 127.0.0.1/32,::1/128。
TRUSTED_PROXY_CIDRS=
OPENSSL_BINARY=openssl
ACME_SH_BINARY=acme.sh

# ---------- Compose 宿主机映射 ----------
# APP_PORT 是宿主机端口，容器内端口固定为 8080。
APP_PORT=8080
# 修改为实际存在、并允许 UID/GID 10001:10001 读写的宿主机目录。
DATA_HOST_DIR=./data
CERTS_HOST_DIR=./certs
APP_UID=10001
APP_GID=10001
