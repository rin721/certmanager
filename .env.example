APP_NAME=CertMate
APP_ENV=production
LISTEN_ADDR=:8080
TZ=Asia/Shanghai

ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_PASSWORD_HASH=
ADMIN_PASSWORD_FILE=
ADMIN_PASSWORD_HASH_FILE=
SESSION_SECRET=
SESSION_SECRET_FILE=
SESSION_COOKIE_SECURE=true
APP_ENCRYPTION_KEY=
APP_ENCRYPTION_KEY_FILE=

DATA_DIR=/data
CERT_OUTPUT_DIR=/certs
ACME_HOME=/data/acme
ACME_CHALLENGE_DIR=/data/challenges

# 可填 letsencrypt、letsencrypt_test、zerossl，或自定义 HTTPS ACME Directory URL
DEFAULT_CA=letsencrypt
DEFAULT_ACME_EMAIL=
DEFAULT_KEY_TYPE=ec-256
ENABLE_ACME=true
ENABLE_SELF_SIGNED=true
LOG_LEVEL=info
TRUST_PROXY=false
# TRUST_PROXY=true 时必填，例如仅信任同机 Nginx：127.0.0.1/32,::1/128
TRUSTED_PROXY_CIDRS=
OPENSSL_BINARY=openssl
ACME_SH_BINARY=acme.sh

APP_PORT=8080
DATA_HOST_DIR=./data
CERTS_HOST_DIR=./certs
APP_UID=10001
APP_GID=10001
