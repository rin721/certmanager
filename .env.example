# CertMate Docker Compose 配置模板
#
# 推荐部署入口：bash scripts/deploy.sh init
# 第一次运行会把本文件复制为 .env 后停止；编辑 .env，再次运行才会启动服务。
# .env 包含敏感信息，只能保存在部署主机，禁止提交到 Git。

# ================================================================
# 用户必须确认：管理员账户
# ================================================================
ADMIN_USERNAME=admin

# 四种密码来源至少配置一项，应用按下面的先后顺序选择：
# 1. ADMIN_PASSWORD_HASH_FILE
# 2. ADMIN_PASSWORD_HASH
# 3. ADMIN_PASSWORD_FILE
# 4. ADMIN_PASSWORD
#
# 生产环境推荐 bcrypt：
#   htpasswd -bnBC 12 '' '你的密码' | tr -d ':\n'
# bcrypt 含有 $，写入 .env 时必须使用单引号，例如：
#   ADMIN_PASSWORD_HASH='$2y$12$...'
ADMIN_PASSWORD_HASH_FILE=
ADMIN_PASSWORD_HASH=

# 文件变量填写容器内只读 Secret 文件路径，需要另外通过 Compose override 挂载。
ADMIN_PASSWORD_FILE=
# 明文方式便于首次试用，但生产环境不推荐；含特殊字符时同样使用单引号。
ADMIN_PASSWORD=

# ================================================================
# 脚本自动生成：会话与 DNS 凭据加密密钥
# ================================================================
# 保持下面两个值为空。完成管理员和目录配置后再次运行 deploy.sh init，
# 脚本会生成两个不同的 32 字节随机值并持久化；以后升级不会重新生成。
# 修改 SESSION_SECRET 会让现有登录会话失效。
# 修改 APP_ENCRYPTION_KEY 可能导致数据库中的 DNS 凭据无法解密。
SESSION_SECRET=
APP_ENCRYPTION_KEY=

# 高级用法：使用容器内只读 Secret 文件时填写路径；脚本不会再生成对应内联值。
SESSION_SECRET_FILE=
APP_ENCRYPTION_KEY_FILE=

# ================================================================
# 用户必须确认：Compose 宿主机映射
# ================================================================
# APP_PORT 是宿主机端口，容器内监听端口固定为 8080。
APP_PORT=8080

# 默认使用项目根目录下的相对路径；确有跨项目共享需求时也可填写明确的绝对路径。
# 两个目录必须彼此独立，并允许 APP_UID/APP_GID 对应的容器用户读写。
DATA_HOST_DIR=./data
CERTS_HOST_DIR=./certs
APP_UID=10001
APP_GID=10001

# ================================================================
# 通常保持默认：应用与容器内路径
# ================================================================
APP_NAME=CertMate
APP_ENV=production
LISTEN_ADDR=:8080
TZ=Asia/Shanghai

# 这些都是容器内路径。Compose 部署时不要替换成宿主机路径；
# 宿主机只修改上面的 DATA_HOST_DIR 和 CERTS_HOST_DIR。
DATA_DIR=/data
CERT_OUTPUT_DIR=/certs
ACME_HOME=/data/acme
ACME_CHALLENGE_DIR=/data/challenges

# HTTPS 生产环境保持 true。本机纯 HTTP 试用时登录 Cookie 无法回传，
# 仅可在隔离环境临时改为 false。
SESSION_COOKIE_SECURE=true

# ================================================================
# 可选：证书默认值、日志与反向代理
# ================================================================
# DEFAULT_CA 可填 letsencrypt、letsencrypt_test、zerossl，
# 或不含用户名、密码和 URL 片段的 HTTPS ACME Directory URL。
DEFAULT_CA=letsencrypt
DEFAULT_ACME_EMAIL=
DEFAULT_KEY_TYPE=ec-256
ENABLE_ACME=true
ENABLE_SELF_SIGNED=true

LOG_LEVEL=info
# 只有 CertMate 位于可信反向代理后才设为 true；同时必须填写明确的代理 CIDR。
TRUST_PROXY=false
TRUSTED_PROXY_CIDRS=

# 容器镜像已提供这些工具，通常不需要修改。
OPENSSL_BINARY=openssl
ACME_SH_BINARY=acme.sh
